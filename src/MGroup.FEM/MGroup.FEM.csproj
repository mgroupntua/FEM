<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Authors>George Stavroulakis, Dimitris Tsapetis</Authors>
    <Product>MSolve</Product>
    <Description>A series of generic classes and interfaces for spatially discretizing computational mechanics problems using the finite element method</Description>
    <PackageProjectUrl>http://mgroup.ntua.gr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mgroupntua/FEM</RepositoryUrl>
    <PackageIconUrl>https://github.com/mgroupntua/FEM/raw/develop/MGroupFEM.png</PackageIconUrl>
  </PropertyGroup>

  <!-- Import the global props file for development on local machines-->
  <Import Project="..\..\..\Directory.Build.props" Condition="Exists('..\..\..\Directory.Build.props')" />
  <PropertyGroup>
    <UseLocalMSolveProjects Condition="'$(UseLocalMSolveProjects)' == ''">false</UseLocalMSolveProjects>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalMSolveProjects)' == 'false'">
    <PackageReference Include="MGroup.MSolve.Core" Version="0.2.0-unstable.118" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalMSolveProjects)' == 'true'">
    <ProjectReference Include="..\..\..\MSolve.Core\src\MGroup.MSolve.Core.csproj" />
  </ItemGroup>
</Project>
